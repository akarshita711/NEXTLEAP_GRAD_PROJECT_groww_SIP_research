<style>
  :root {
    --green: #00D09C; --green-dark: #00A97F; --green-soft: #E6FAF5;
    --blue: #5367F5; --blue-soft: #ECEEFE; --navy: #0B0B21;
    --ink: #1B1C2E; --ink-2: #44475B; --muted: #7C7E8C; --line: #E8E9EE; --skel: #EEEFF3;
    --amber: #F5B700;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Inter", "Liberation Sans", sans-serif; background: transparent; display: flex; gap: 40px; padding: 30px; color: var(--ink); }
  .phone { width: 412px; height: 866px; border-radius: 54px; background: #23233A; padding: 11px; box-shadow: 0 0 0 1.5px #6E6F94; flex: none; }
  .screen { width: 390px; height: 844px; border-radius: 44px; overflow: hidden; position: relative; background: #fff; display: flex; flex-direction: column; }
  .status { height: 47px; display: flex; align-items: center; justify-content: space-between; padding: 6px 30px 0 34px; font-weight: 600; font-size: 16px; flex: none; }
  .status .icons { display: flex; gap: 6px; align-items: center; }
  .island { position: absolute; top: 11px; left: 50%; transform: translateX(-50%); width: 120px; height: 34px; border-radius: 20px; background: #000; }
  .home-ind { position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%); width: 134px; height: 5px; border-radius: 3px; background: #1B1C2E; }

  /* Screen 0: Explore */
  .mf-head { display: flex; align-items: center; gap: 12px; padding: 14px 20px 8px; }
  .mf-logo { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(160deg, #C9CBD6, #E6E7EE); }
  .mf-title { font-size: 21px; font-weight: 600; flex: 1; }
  .ic { width: 26px; height: 26px; }
  .avatar { width: 36px; height: 36px; border-radius: 50%; background: #3E4A57; color: #fff; display: grid; place-items: center; font-weight: 600; font-size: 16px; }
  .tabs { display: flex; gap: 26px; padding: 12px 20px 0; border-bottom: 1px solid var(--line); font-size: 16px; color: var(--muted); font-weight: 500; }
  .tabs span { padding-bottom: 11px; }
  .tabs .on { color: var(--ink); border-bottom: 3px solid var(--ink); }
  .sipal-entry { margin: 14px 16px 4px; border-radius: 16px; background: var(--green-soft); border: 1.5px solid var(--green); padding: 12px 14px; display: flex; align-items: center; gap: 12px; }
  .sipal-entry .txt { flex: 1; }
  .sipal-entry .name { font-weight: 700; font-size: 16px; display: flex; align-items: center; gap: 8px; }
  .pill { font-size: 10.5px; font-weight: 700; letter-spacing: .04em; color: #fff; background: var(--blue); border-radius: 10px; padding: 2px 7px; }
  .sipal-entry .sub { font-size: 13px; color: var(--ink-2); margin-top: 3px; line-height: 1.35; }
  .entry-dot { font-size: 11.5px; font-weight: 600; color: var(--blue); background: var(--blue-soft); border-radius: 10px; padding: 3px 8px; display: inline-block; margin-top: 6px; }
  .sec-head { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px 10px; }
  .sec-head h3 { font-size: 19px; font-weight: 600; }
  .sec-head span { color: var(--muted); font-size: 15px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 0 16px; }
  .fcard { border: 1px solid var(--line); border-radius: 16px; padding: 14px; height: 150px; display: flex; flex-direction: column; gap: 10px; }
  .sk { background: var(--skel); border-radius: 6px; }
  .bnav { margin-top: auto; border-top: 1px solid var(--line); display: flex; justify-content: space-around; padding: 9px 6px 26px; font-size: 12px; color: var(--muted); }
  .bnav div { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .bnav .on { color: var(--blue); font-weight: 600; }
  .bnav .b { width: 24px; height: 24px; border-radius: 6px; border: 2px solid currentColor; }

  /* Screen 1: lock screen */
  .lock { background: radial-gradient(120% 70% at 50% 18%, #1C2060 0%, var(--navy) 62%), var(--navy); color: #fff; }
  .lock .status { color: #fff; }
  .lock-date { text-align: center; margin-top: 30px; font-size: 19px; font-weight: 500; opacity: .9; }
  .lock-time { text-align: center; font-size: 86px; font-weight: 600; letter-spacing: -2px; line-height: 1.05; }
  .notif { margin: 230px 12px 0; background: rgba(245,246,250,.93); color: var(--ink); border-radius: 24px; padding: 14px 15px 15px; display: flex; gap: 12px; box-shadow: 0 8px 30px rgba(0,0,0,.35); }
  .notif .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .notif .t { font-weight: 700; font-size: 15px; }
  .notif .when { font-size: 13px; color: var(--muted); flex: none; }
  .notif .b { font-size: 14.5px; line-height: 1.38; margin-top: 3px; color: #2A2B3D; }
  .lock-foot { position: absolute; bottom: 44px; left: 0; right: 0; display: flex; justify-content: space-between; padding: 0 46px; }
  .lock-foot div { width: 50px; height: 50px; border-radius: 50%; background: rgba(255,255,255,.16); }
  .lock .home-ind { background: #fff; }

  /* Screen 2: SIPal Assistant */
  .nav { height: 46px; display: flex; align-items: center; padding: 0 14px; border-bottom: 1px solid var(--line); flex: none; }
  .nav .ttl { flex: 1; text-align: center; font-weight: 600; font-size: 17px; margin-right: 26px; }
  .body2 { padding: 0 16px; display: flex; flex-direction: column; gap: 11px; background: #F7F8FA; flex: 1; }
  .hero { display: flex; align-items: center; gap: 10px; padding-top: 6px; }
  .hero .hi { font-size: 17px; font-weight: 700; }
  .hero .hs { font-size: 13px; color: var(--muted); margin-top: 3px; }
  .card { background: #fff; border-radius: 18px; padding: 13px 14px 14px; border: 1px solid var(--line); }
  .card .row { display: flex; justify-content: space-between; align-items: center; }
  .card h4 { font-size: 16px; font-weight: 700; }
  .card .lbl { font-size: 11.5px; font-weight: 600; color: var(--muted); margin-top: 2px; }
  .card p { font-size: 14px; line-height: 1.42; color: #2A2B3D; margin-top: 7px; }
  .anim { position: relative; }
  .anim small { position: absolute; right: -2px; bottom: -4px; font-size: 9.5px; color: var(--muted); }
  .cta h4 { font-size: 16px; font-weight: 700; margin-bottom: 10px; }
  .btn { height: 48px; border-radius: 12px; display: grid; place-items: center; font-weight: 700; font-size: 16px; }
  .btn.pri { background: var(--green); color: #fff; }
  .btn.sec { margin-top: 9px; border: 1.5px solid var(--green); color: var(--green-dark); height: 44px; font-size: 15px; }
  .more { text-align: center; font-size: 13px; color: var(--blue); font-weight: 600; margin-top: 9px; }
  .ask { background: #fff; border: 1px solid var(--line); border-radius: 24px; height: 44px; display: flex; align-items: center; padding: 0 6px 0 16px; font-size: 14px; color: var(--muted); }
  .ask .q { flex: 1; }
  .ask .send { width: 32px; height: 32px; border-radius: 50%; background: var(--blue); display: grid; place-items: center; }
  .checked { display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 11.5px; color: var(--ink-2); padding-bottom: 26px; }
</style>
