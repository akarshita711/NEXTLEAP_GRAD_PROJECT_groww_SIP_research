      <circle cx="20" cy="29.5" r="1.7" fill="#0B0B21"/><circle cx="28" cy="29.5" r="1.7" fill="#0B0B21"/>
      <path d="M19.5 34 Q24 38 28.5 34" stroke="#0B0B21" stroke-width="1.8" fill="none" stroke-linecap="round"/>
    </symbol>
