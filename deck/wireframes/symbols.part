      <circle cx="47" cy="74" r="4" fill="#0B0B21"/><circle cx="69" cy="74" r="4" fill="#0B0B21"/>
      <circle cx="48.3" cy="72.6" r="1.3" fill="#fff"/><circle cx="70.3" cy="72.6" r="1.3" fill="#fff"/>
      <path d="M49 85 Q58 93 67 85" stroke="#0B0B21" stroke-width="3" fill="none" stroke-linecap="round"/>
