<svg width="0" height="0" style="position:absolute">
  <defs>
    <!-- SIPal mini logo: green tile, white sprout with a smiling seed face -->
    <symbol id="sipal-mini" viewBox="0 0 48 48">
      <rect width="48" height="48" rx="11" fill="#00D09C"/>
